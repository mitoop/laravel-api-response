{
  "name": "mitoop/laravel-api-response",
  "description": "Unified JSON envelopes for Laravel APIs.",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "mitoop",
      "email": "me@mitoop.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11|^12|^13"
  },
  "autoload": {
    "psr-4": {
      "Mitoop\\Http\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mitoop\\Http\\ResponderServiceProvider"
      ]
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "laravel/pint": "^1.32"
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit"
  }
}
